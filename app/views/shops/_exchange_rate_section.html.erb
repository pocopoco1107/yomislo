<turbo-frame id="exchange_rates_<%= shop.id %>">
  <%
    error_denomination = local_assigns.fetch(:error_denomination, nil)
    error_rate_key = local_assigns.fetch(:error_rate_key, nil)
    error_message = local_assigns.fetch(:error_message, nil)
  %>
  <div class="mt-4 pt-3 border-t border-border/50">
    <div class="flex items-center gap-1.5 mb-2">
      <span class="font-heading text-sm text-foreground flex items-center gap-1.5">
        <span class="text-[0.7em] text-primary" aria-hidden="true">▶</span>
        交換率
      </span>
      <span class="text-xs font-medium text-primary">タップで報告</span>
    </div>

    <%
      denominations = [
        { key: "twenty_yen", label: "20スロ", unit: "円/枚", placeholder: "例: 18.0", step: 0.1, min: 1.0, max: 20.0 },
        { key: "five_yen",   label: "5スロ",  unit: "枚交換", placeholder: "例: 5.6",  step: 0.1, min: 1.0, max: 50.0 }
      ]
    %>

    <div class="space-y-4">
      <% denominations.each do |denom| %>
        <%
          summary     = exchange_rate_summaries[denom[:key]]
          user_report = user_reports[denom[:key]]
          user_rate   = user_report&.rate_key
          denom_error = error_message.present? && error_denomination == denom[:key] ? error_message : nil
        %>
        <div>
          <p class="text-xs font-semibold text-muted-foreground mb-1.5"><%= denom[:label] %></p>
          <% if denom_error %>
            <p class="text-xs text-destructive bg-destructive/10 rounded-md px-2 py-1 mb-1.5" role="alert" aria-live="assertive"><%= denom_error %></p>
          <% end %>
          <div class="flex items-center gap-1.5 flex-wrap">
            <%# 等価ボタン %>
            <%
              is_touka = user_rate == "touka"
              btn_class = is_touka \
                ? "bg-primary text-primary-foreground ring-2 ring-primary/40" \
                : "bg-muted/50 text-muted-foreground hover:bg-muted"
            %>
            <%= form_with url: exchange_rate_reports_path, scope: :exchange_rate_report, data: { turbo: true, controller: "vote", action: "submit->vote#submit" } do |f| %>
              <%= f.hidden_field :shop_id, value: shop.id %>
              <%= f.hidden_field :denomination, value: denom[:key] %>
              <%= f.hidden_field :rate_key, value: "touka" %>
              <%= f.submit "等価",
                  class: "#{btn_class} rounded-lg px-4 py-2 text-xs font-bold active:scale-95 transition-all duration-150 min-h-[44px] cursor-pointer" %>
            <% end %>

            <%# 自由入力 %>
            <%
              is_custom = user_rate.present? && user_rate != "touka"
              custom_value = is_custom ? user_rate : ""
              # バリデーション失敗時は入力値を消さずに残す
              if denom_error && error_rate_key.present? && error_rate_key != "touka"
                custom_value = error_rate_key
              end
            %>
            <%= form_with url: exchange_rate_reports_path, scope: :exchange_rate_report, class: "flex items-center gap-1.5", data: { turbo: true } do |f| %>
              <%= f.hidden_field :shop_id, value: shop.id %>
              <%= f.hidden_field :denomination, value: denom[:key] %>
              <div class="flex items-center rounded-lg overflow-hidden border border-border/50 <%= is_custom ? 'ring-2 ring-primary/40' : '' %>">
                <%= f.number_field :rate_key,
                    value: custom_value,
                    placeholder: denom[:placeholder],
                    step: denom[:step],
                    min: denom[:min],
                    max: denom[:max],
                    required: true,
                    class: "w-16 px-2 py-2 text-xs bg-muted/50 text-foreground border-0 focus:outline-none focus:ring-0 min-h-[44px] text-center #{is_custom ? 'bg-primary/10 font-bold' : ''}",
                    "aria-label": "交換率を入力（例: #{denom[:placeholder].sub('例: ', '')}）" %>
                <span class="px-2 py-2 text-xs text-muted-foreground bg-muted/50 border-l border-border/50 whitespace-nowrap"><%= denom[:unit] %></span>
              </div>
              <%= f.submit(is_custom ? "更新" : "報告",
                  class: "bg-primary text-primary-foreground hover:bg-primary/90 rounded-lg px-3 py-2 text-xs font-bold active:scale-95 transition-all duration-150 min-h-[44px] cursor-pointer whitespace-nowrap") %>
            <% end %>
          </div>

          <%# 報告された交換率の内訳（実際の値を見せる） %>
          <div class="mt-1.5">
            <% if summary && summary.total_reports > 0 %>
              <% distribution = (summary.rate_distribution || {}).sort_by { |_, c| -c.to_i } %>
              <div class="flex flex-wrap items-center gap-1.5">
                <% distribution.each do |rate_key, count| %>
                  <% is_consensus = summary.consensus_rate.present? && rate_key == summary.consensus_rate %>
                  <span class="inline-flex items-center gap-1 text-xs rounded-md px-1.5 py-0.5 <%= is_consensus ? 'bg-primary/15 text-primary font-bold' : 'bg-muted/60 text-muted-foreground' %>">
                    <%= ExchangeRateSummary.rate_label(rate_key, denom[:key]) %>
                    <span class="tabular-nums"><%= count %>人</span>
                  </span>
                <% end %>
              </div>
              <% if summary.consensus_rate.blank? && summary.total_reports >= 2 %>
                <p class="text-xs text-muted-foreground mt-1">まだ意見が分かれています</p>
              <% end %>
            <% else %>
              <span class="text-xs text-muted-foreground">まだ報告がありません</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</turbo-frame>
