<%#
  Trend section with period tabs + weekly summary
  Local variables:
    shop       - Shop instance
    trend_data - Array of trend hashes (7-day default)
    weekly_summary - Hash with weekly summary data
%>
<details id="shop_trend" class="bg-card border border-border rounded-lg mt-8 group" open>
  <summary class="list-none cursor-pointer select-none p-4 flex items-center justify-between min-h-[44px] hover:bg-secondary/30 transition-colors rounded-lg">
    <h2 class="font-heading text-sm text-foreground flex items-center gap-1.5">
      <span class="text-[0.7em] text-primary" aria-hidden="true">▶</span>
      記録トレンド
    </h2>
    <svg class="w-4 h-4 text-muted-foreground transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
  </summary>
  <div class="px-4 pb-4">
    <div class="flex items-center justify-end mb-3">
      <%# Period tabs %>
      <div data-controller="trend-tab"
           data-trend-tab-url-value="<%= trend_data_shop_path(shop.slug) %>"
           data-trend-tab-current-value="7"
           class="flex gap-1">
        <% [
          ["7", "7日"],
          ["30", "30日"],
          ["all", "全期間"]
        ].each do |period, label| %>
          <button data-trend-tab-target="tab"
                  data-period="<%= period %>"
                  data-action="click->trend-tab#switch"
                  class="px-2.5 py-1 text-[11px] font-medium rounded-md transition-all duration-150 min-h-[32px]
                         <%= period == '7' ? 'bg-primary text-primary-foreground' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80' %>">
            <%= label %>
          </button>
        <% end %>
      </div>
    </div>

    <%# Chart area (Turbo Frame for dynamic updates) %>
    <%= render "shops/trend_chart_frame",
        trend_data: trend_data,
        period: "7",
        shop: shop %>

    <%# === Weekly Summary === %>
    <% if weekly_summary[:total_votes].to_i > 0 %>
      <div class="mt-4">
        <%= render "shops/weekly_summary", summary: weekly_summary %>
      </div>
    <% end %>
  </div>
</details>
