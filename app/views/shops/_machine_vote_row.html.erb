<turbo-frame id="machine_vote_<%= machine_model.id %>" data-filter-name="<%= machine_model.name.to_s.downcase %>">
  <%
    user_pr = local_assigns[:user_play_record]

    # 記録済みの行だけ最初から開く。開いた行は記録UIをその場で描画し、閉じた行は
    # details を開いた瞬間に shops#machine_row から取得する。閉じた中身を初期HTMLに
    # 含めると 1機種あたり記録フォーム16個 × 設置機種数が丸損になる。
    # 記録・削除後の turbo_stream 再描画は expanded: true を渡す。記録を取り消して
    # user_vote が消えても、開いて操作していた行が勝手に閉じないようにするため。
    expanded = local_assigns.fetch(:expanded) { user_vote.present? || user_pr.present? }

    total_votes_count = vote_summary&.total_votes.to_i +
      (vote_summary ? vote_summary.reset_yes_count + vote_summary.reset_no_count : 0)
  %>

  <details class="bg-card rounded-lg overflow-hidden group shadow-sm"
           data-controller="vote lazy-details"
           data-action="toggle->lazy-details#load"
           <%= "open" if expanded %>>
    <%# === ヘッダー: 画像+機種名+基本情報 === %>
    <summary class="list-none px-3 py-2 cursor-pointer select-none hover:bg-secondary/50 active:bg-secondary transition-colors min-h-[44px]">
      <div class="flex items-center gap-2">
        <% if machine_model.image_url.present? %>
          <img src="<%= machine_model.image_url %>"
               alt="" loading="lazy"
               class="w-8 h-8 object-contain rounded bg-secondary shrink-0"
               data-controller="image-fallback" data-action="error->image-fallback#error">
        <% end %>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="font-bold text-xs text-foreground truncate"><%= machine_model.name %></span>
            <svg class="w-3.5 h-3.5 text-muted-foreground shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </div>
          <div class="flex items-center gap-1 mt-0.5 flex-wrap">
            <span class="text-[9px] font-bold px-1 py-px rounded <%= machine_model.display_type_badge_class %>">
              <%= machine_model.display_type_label %>
            </span>
            <% if machine_model.generation_label %>
              <span class="text-[9px] font-bold px-1 py-px rounded <%= machine_model.generation_badge_class %>">
                <%= machine_model.generation_label %>
              </span>
            <% end %>
            <% if defined?(unit_count) && unit_count %>
              <span class="text-[9px] text-muted-foreground"><%= unit_count %>台</span>
            <% end %>
            <% if total_votes_count > 0 %>
              <span class="text-[9px] font-bold tabular-nums text-primary">投稿 <%= total_votes_count %></span>
            <% end %>
          </div>
        </div>
      </div>
    </summary>

    <%# === 投票UI === %>
    <% if expanded %>
      <%= turbo_frame_tag "machine_vote_body_#{machine_model.id}" do %>
        <%= render "shops/machine_vote_body",
            machine_model: machine_model,
            vote_summary: vote_summary,
            user_vote: user_vote,
            user_play_record: user_pr,
            shop: shop,
            date: date %>
      <% end %>
    <% else %>
      <%# src は data 属性に置き、lazy-details が details 展開時にセットする。
          loading="lazy" は閉じた details でも交差判定が走る余地があり、設置機種数ぶんの
          リクエストが一斉に飛びうるため使わない。 %>
      <%= turbo_frame_tag "machine_vote_body_#{machine_model.id}",
          data: { lazy_details_target: "frame",
                  src: machine_row_shop_path(shop.slug, machine_model.id, date: date) } do %>
        <div class="px-3 py-4 border-t border-border/50 bg-secondary/30 text-center text-[10px] text-muted-foreground">
          読み込み中…
        </div>
      <% end %>
    <% end %>
  </details>
</turbo-frame>
