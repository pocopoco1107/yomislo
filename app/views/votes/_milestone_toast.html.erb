<%# マイルストーン達成トースト。既存の進化トーストと同じ .rpg-window--glow 枠を使い、
    dismissable が 5秒後に自動フェード。#pet_toast コンテナに append される。
    milestone: { type:, threshold: or setting: } を UiHelper#milestone_display で描画情報に変換。 %>
<% info = milestone_display(milestone) %>
<% if info %>
  <div class="pointer-events-auto rpg-window--glow px-4 py-3 flex items-center gap-3 animate-fade-in"
       role="status"
       aria-live="polite"
       data-controller="dismissable"
       data-dismissable-delay-value="5000">
    <span class="text-3xl leading-none shrink-0" aria-hidden="true"><%= info[:emoji] %></span>
    <div class="min-w-0">
      <p class="font-heading text-sm text-slot-yellow"><%= info[:title] %></p>
      <p class="text-xs text-muted-foreground mt-0.5"><%= info[:desc] %></p>
    </div>
    <% if info[:share_text] %>
      <%= link_to milestone_share_url(info[:share_text]), target: "_blank", rel: "noopener",
            class: "shrink-0 ml-auto flex items-center gap-1 rounded-full border border-border px-2.5 py-1 text-xs text-foreground hover:bg-secondary",
            "aria-label": "Xでシェア" do %>
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        シェア
      <% end %>
    <% end %>
  </div>
<% end %>
