<%= turbo_stream.replace "machine_vote_#{@machine_model.id}" do %>
  <%= render "shops/machine_vote_row",
    machine_model: @machine_model,
    vote_summary: @vote_summary,
    user_vote: @vote,
    user_play_record: PlayRecord.find_by(voter_token: voter_token, shop_id: @shop.id, machine_model_id: @machine_model.id, played_on: @vote.voted_on),
    shop: @shop,
    date: @vote.voted_on,
    unit_count: ShopMachineModel.find_by(shop_id: @shop.id, machine_model_id: @machine_model.id)&.unit_count,
    expanded: true %>
<% end %>

<% if @gold_gain.to_i > 0 %>
  <%= turbo_stream.append "pet_toast" do %>
    <%= render "votes/gold_toast", gain: @gold_gain %>
  <% end %>
<% end %>

<% Array(@milestones).each do |milestone| %>
  <%= turbo_stream.append "pet_toast" do %>
    <%= render "votes/milestone_toast", milestone: milestone %>
  <% end %>
<% end %>

<% if @pet_result&.evolved? %>
  <%= turbo_stream.append "pet_toast" do %>
    <%= render "pets/evolution_toast", pet: @pet_result.pet %>
  <% end %>
<% end %>

<%= turbo_stream.replace "daily-summary" do %>
  <%= render "shops/daily_summary", **@daily_summary_locals %>
<% end %>
