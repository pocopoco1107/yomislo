<%# === Mobile Bottom Tab Bar (md以下で表示) === %>
<%# アイコンはドット絵(8bit)シルエット。viewBox 0 0 12 12 + crispEdges でピクセル感を出す。
    色は親の text-* (アクティブ=primary / 非アクティブ=muted) を currentColor で継承。 %>
<nav class="fixed bottom-0 inset-x-0 z-40 bg-background/95 backdrop-blur-md border-t-2 border-rpg-frame/60 md:hidden pb-[env(safe-area-inset-bottom)]"
     aria-label="メインナビゲーション">
  <div class="grid grid-cols-4 h-14">
    <%
      tabs = [
        { path: root_path, label: "ホーム", icon: "home", match: root_path },
        { path: search_path, label: "検索", icon: "search", match: search_path },
        { path: play_records_path, label: "収支", icon: "wallet", match: play_records_path },
        { path: voter_status_path, label: "マイ", icon: "user", match: voter_status_path },
      ]
    %>
    <% tabs.each do |tab| %>
      <%
        is_active = current_page?(tab[:match])
        color = is_active ? "text-primary" : "text-muted-foreground"
        label_class = is_active ? "dq-cursor dq-cursor--blink" : ""
      %>
      <%= link_to tab[:path], class: "flex flex-col items-center justify-center gap-1 #{color} active:scale-95 transition-all duration-100", data: { turbo_frame: "_top" } do %>
        <svg class="w-5 h-5" viewBox="0 0 12 12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
          <% case tab[:icon] %>
          <% when "home" %>
            <rect x="5" y="1" width="2" height="1"/><rect x="4" y="2" width="4" height="1"/><rect x="3" y="3" width="6" height="1"/><rect x="2" y="4" width="8" height="1"/><rect x="1" y="5" width="10" height="1"/>
            <rect x="2" y="6" width="8" height="5"/>
          <% when "search" %>
            <rect x="1" y="1" width="6" height="1"/><rect x="1" y="6" width="6" height="1"/><rect x="1" y="2" width="1" height="4"/><rect x="6" y="2" width="1" height="4"/>
            <rect x="7" y="7" width="1" height="1"/><rect x="8" y="8" width="1" height="1"/><rect x="9" y="9" width="2" height="2"/>
          <% when "wallet" %>
            <rect x="5" y="1" width="2" height="1"/><rect x="4" y="2" width="4" height="1"/>
            <rect x="3" y="3" width="6" height="1"/><rect x="2" y="4" width="8" height="4"/><rect x="3" y="8" width="6" height="1"/><rect x="4" y="9" width="4" height="1"/>
          <% when "user" %>
            <rect x="4" y="1" width="4" height="3"/>
            <rect x="3" y="6" width="6" height="1"/><rect x="2" y="7" width="8" height="4"/>
          <% end %>
        </svg>
        <span class="text-[10px] font-medium leading-none <%= label_class %>"><%= tab[:label] %></span>
      <% end %>
    <% end %>
  </div>
</nav>
