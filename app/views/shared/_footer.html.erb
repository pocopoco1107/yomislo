<footer class="mt-8 md:mt-12 mb-16 md:mb-0">
  <div class="h-px w-full bg-border/50"></div>
  <div class="mx-auto max-w-6xl px-4 py-8 space-y-4">
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
      <%# Service Links %>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <%= link_to rankings_path,
              class: "text-muted-foreground transition-colors hover:text-foreground inline-flex items-center gap-1.5 py-2 min-h-[44px]" do %>
          ランキング
        <% end %>
        <%= link_to play_records_path,
              class: "text-muted-foreground transition-colors hover:text-foreground inline-flex items-center gap-1.5 py-2 min-h-[44px]" do %>
          収支カレンダー
        <% end %>
        <%= link_to new_feedback_path,
              class: "text-muted-foreground transition-colors hover:text-foreground inline-flex items-center gap-1.5 py-2 min-h-[44px]" do %>
          <%= icon_message("w-4 h-4") %>
          ご意見・ご要望
        <% end %>
        <%= link_to new_shop_request_path,
              class: "text-muted-foreground transition-colors hover:text-foreground inline-flex items-center gap-1.5 py-2 min-h-[44px]" do %>
          <%= icon_plus_circle("w-4 h-4") %>
          店舗追加リクエスト
        <% end %>
      </div>

      <%# Copyright %>
      <div class="text-xs text-muted-foreground text-center sm:text-right">
        <p>&copy; <%= Date.current.year %> ヨミスロ</p>
      </div>
    </div>

    <%# Legal Links %>
    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-3 gap-y-1 text-[11px] text-muted-foreground/70 border-t border-border/30 pt-3">
      <%= link_to "ヨミスロについて", about_path, class: "hover:text-foreground transition-colors" %>
      <span>·</span>
      <%= link_to "プライバシーポリシー", privacy_path, class: "hover:text-foreground transition-colors" %>
      <span>·</span>
      <%= link_to "利用規約", terms_path, class: "hover:text-foreground transition-colors" %>
      <span>·</span>
      <%= link_to "特定商取引法に基づく表記", tokushou_path, class: "hover:text-foreground transition-colors" %>
    </div>
  </div>
</footer>
