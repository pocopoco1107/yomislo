<%# レクタングル型おすすめ案件。サイドカラム・ステータス画面下などの縦長/正方形エリア向け。 %>
<aside class="relative my-4 overflow-hidden rounded-lg border border-border bg-card shadow-sm"
       data-promotion-slot="<%= slot_key %>">
  <a href="<%= promotion_click_path(promotion) %>"
     target="_blank"
     rel="sponsored noopener noreferrer"
     class="block hover:bg-secondary/40 transition-colors"
     aria-label="<%= promotion.title %>（おすすめ）">
    <% if promotion.image_url.present? %>
      <div class="bg-muted overflow-hidden" style="aspect-ratio: 16 / 9;">
        <img src="<%= promotion.image_url %>"
             alt=""
             loading="lazy"
             class="h-full w-full object-cover">
      </div>
    <% end %>
    <div class="p-4">
      <p class="text-sm font-semibold text-foreground">
        <%= promotion.title %>
      </p>
      <% if promotion.description.present? %>
        <p class="mt-1.5 text-xs text-muted-foreground line-clamp-3">
          <%= promotion.description %>
        </p>
      <% end %>
      <p class="mt-2 text-[11px] text-muted-foreground">
        <%= promotion.category_label %>
      </p>
    </div>
  </a>
  <span class="pointer-events-none absolute right-2 top-2 rounded-md bg-foreground/70 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-background">
    PR
  </span>
</aside>
