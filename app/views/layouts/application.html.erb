<!DOCTYPE html>
<html lang="ja">
  <head>
    <%= display_meta_tags site: "ヨミスロ", reverse: true, separator: "|" %>
    <link rel="canonical" href="<%= canonical_url %>">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="turbo-prefetch" content="false">
    <meta name="theme-color" content="#22c55e">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="manifest" href="/manifest.json">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Google Fonts: Inter (Latin/数値) + M PLUS 1 (Japanese 本文) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=M+PLUS+1:wght@400;500;700&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/icon-192.svg">

    <script nonce="<%= content_security_policy_nonce %>">
      // FOUC防止: ページ読み込み前にテーマ適用 (デフォルト: system = OSの設定に追従)
      (function() {
        var saved = localStorage.getItem("theme");
        var theme = (saved === "light" || saved === "dark") ? saved : "system";
        var isDark = theme === "dark" ||
          (theme === "system" && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col">
    <%= render "shared/header" %>

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 pt-4 sm:pt-6 pb-20 md:pb-12">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
    <%= render "shared/bottom_tab_bar" %>

    <%# 相棒ペットの進化お祝いトースト差し込み口 (Turbo Stream で append) %>
    <div id="pet_toast" class="fixed inset-x-0 bottom-20 md:bottom-6 z-50 flex flex-col items-center gap-2 px-4 pointer-events-none"></div>

    <script nonce="<%= content_security_policy_nonce %>">
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/service-worker.js");
      }
    </script>
  </body>
</html>
